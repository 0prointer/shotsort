{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShotSort",
  "identifier": "de.shotsort.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShotSort",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#1c1c1c"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ShotSort",
    "copyright": "© 2026",
    "category": "Photography",
    "shortDescription": "Fotos schnell aussortieren und in Zielordner kopieren",
    "longDescription": "Fotos aus einem Shooting schnell durchsehen und die besten per Tastendruck in bis zu neun Zielordner kopieren. Die Originale bleiben unverändert.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNjMxOUM1MTlGMzQzQTEKUldTaFEvTVp4UmxqUElYbGdaRTlNNHRySkkxdFhSSUVKMTFTaGpaMDd2cDR0Qk5idFJnREdiOUUK",
      "endpoints": [
        "https://github.com/0prointer/shotsort/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
